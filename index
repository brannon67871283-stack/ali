<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>volt Language Playground ⚡</title>
    <!-- Google Fonts للخطوط الاحترافية -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-main: #0B0F19;
            --bg-card: #151D30;
            --accent: #00E5FF;
            --accent-glow: rgba(0, 229, 255, 0.4);
            --text-main: #F3F4F6;
            --text-muted: #9CA3AF;
            --border: #24324F;
            --volt-yellow: #FFEA00;
            --console-bg: #05070B;
            --success: #10B981;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* الهيدر الاحترافي */
        header {
            background: rgba(21, 29, 48, 0.7);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-badge {
            background: linear-gradient(135deg, var(--volt-yellow), var(--accent));
            color: #000;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.9rem;
            box-shadow: 0 0 15px var(--accent-glow);
        }

        .logo-title {
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .architect-tag {
            font-size: 0.8rem;
            color: var(--text-muted);
            background: var(--bg-main);
            padding: 4px 12px;
            border-radius: 20px;
            border: 1px solid var(--border);
        }

        /* مساحة العمل الرئيسية */
        .workspace {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            padding: 2rem;
            flex: 1;
            max-width: 1600px;
            width: 100%;
            margin: 0 auto;
        }

        @media (max-width: 968px) {
            .workspace {
                grid-template-columns: 1fr;
            }
        }

        /* كروت المحرر والكونسول */
        .panel {
            background-color: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            position: relative;
        }

        .panel-header {
            background-color: rgba(5, 7, 11, 0.4);
            padding: 0.75rem 1.5rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .panel-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* أزرار التحكم */
        .btn-run {
            background: linear-gradient(135deg, #00E5FF, #00B0FF);
            color: #000;
            border: none;
            padding: 8px 20px;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 15px rgba(0, 229, 255, 0.3);
        }

        .btn-run:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 229, 255, 0.5);
        }

        .btn-run:active {
            transform: translateY(0);
        }

        /* محرّر النصوص */
        .editor-container {
            flex: 1;
            position: relative;
            display: flex;
        }

        .editor-textarea {
            width: 100%;
            height: 450px;
            background-color: transparent;
            border: none;
            color: #E5E7EB;
            font-family: 'Fira Code', monospace;
            font-size: 1rem;
            padding: 1.5rem;
            resize: none;
            outline: none;
            line-height: 1.6;
            tab-size: 4;
            direction: ltr;
            text-align: left;
        }

        /* شاشة العرض والكونسول */
        .console-box {
            background-color: var(--console-bg);
            flex: 1;
            padding: 1.5rem;
            font-family: 'Fira Code', monospace;
            font-size: 0.95rem;
            color: #00FF66;
            overflow-y: auto;
            white-space: pre-wrap;
            direction: ltr;
            text-align: left;
            height: 450px;
        }

        .console-line {
            margin-bottom: 0.5rem;
            line-height: 1.5;
        }

        .system-msg {
            color: var(--accent);
        }

        .error-msg {
            color: #FF3366;
        }

        /* التذييل */
        footer {
            text-align: center;
            padding: 1.5rem;
            font-size: 0.85rem;
            color: var(--text-muted);
            border-top: 1px solid var(--border);
            background: rgba(11, 15, 25, 0.8);
        }
    </style>
</head>
<body>

    <header>
        <div class="logo-area">
            <div class="logo-badge">volt ⚡</div>
            <div class="logo-title">Core Engine Playground</div>
        </div>
        <div class="architect-tag">Lead Architect: Ali Ahmed</div>
    </header>

    <main class="workspace">
        <!-- لوحة المحرر -->
        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">📝 محرر الأكواد (main.fl)</div>
                <button class="btn-run" onclick="runVoltCode()">تشغيل الكود ⚡</button>
            </div>
            <div class="editor-container">
                <textarea class="editor-textarea" id="voltEditor" spellcheck="false"># ==========================================
# تجربة لغة volt ⚡ v3.1 
# ==========================================
use math
use str

out "Welcome to volt Ecosystem!"
out "-------------------------"

# العمليات الحسابية المدعومة
num x = 16
var root = sqr_val(x)
out "Square root of 16 is:"
out root

# التعامل مع النصوص
str developer = "ialidev"
str upper_dev = str_upr(developer)
out "Developer Account:"
out upper_dev
</textarea>
            </div>
        </div>

        <!-- لوحة الكونسول الناتج -->
        <div class="panel">
            <div class="panel-header">
                <div class="panel-title">🖥️ شاشة المخرجات (Terminal)</div>
            </div>
            <div class="console-box" id="voltConsole">
                <div class="console-line system-msg">[volt] Engine initialized. Ready to compile...</div>
            </div>
        </div>
    </main>

    <footer>
        &copy; 2026 volt Language Project • Designed by ialidev
    </footer>

    <script>
        // محاكي المفسر والمترجم للغة volt مع تحويله لـ JS للتشغيل الفوري بالمتصفح
        function runVoltCode() {
            const code = document.getElementById('voltEditor').value;
            const consoleBox = document.getElementById('voltConsole');
            consoleBox.innerHTML = `<div class="console-line system-msg">[volt] Compiling and simulating execution...</div>`;
            
            const lines = code.split('\n');
            let activeLibs = new Set();
            let variables = {};
            let outputLines = [];
            let hasError = false;

            // ثوابت الرياضيات المدمجة بلغة فولت
            const MATH_CONSTANTS = {
                "PI": 3.14159265358979,
                "EUL": 2.71828182845904,
                "PHI": 1.61803398874989
            };

            for (let i = 0; i < lines.length; i++) {
                let line = lines[i].trim();
                
                // تخطي السطور الفارغة والتعليقات
                if (!line || line.startsWith('#')) continue;

                // 1. معالجة استدعاء المكتبات
                if (line.startsWith('use ')) {
                    let lib = line.substring(4).trim();
                    activeLibs.add(lib);
                    continue;
                }

                try {
                    // 2. معالجة طباعة المخرجات (out)
                    if (line.startsWith('out ')) {
                        let content = line.substring(4).trim();
                        
                        // فحص إذا كان نصاً ثابتاً محاطاً باقتباس
                        if ((content.startsWith('"') && content.endsWith('"')) || (content.startsWith("'") && content.endsWith("'"))) {
                            outputLines.push(content.slice(1, -1));
                        } else {
                            // فحص إذا كان متغيراً مسجلاً
                            if (variables.hasOwnProperty(content)) {
                                outputLines.push(variables[content]);
                            } else {
                                // فحص إذا كان ثابتاً رياضياً
                                if (activeLibs.has('math') && MATH_CONSTANTS.hasOwnProperty(content)) {
                                    outputLines.push(MATH_CONSTANTS[content]);
                                } else {
                                    throw new Error(`Variable or constant '${content}' is not declared.`);
                                }
                            }
                        }
                        continue;
                    }

                    // 3. معالجة الإسناد والإعلان عن المتغيرات (str, num, flt, var)
                    if (line.startsWith('str ') || line.startsWith('num ') || line.startsWith('flt ') || line.startsWith('var ')) {
                        let spaceIndex = line.indexOf(' ');
                        let rest = line.substring(spaceIndex).trim();
                        let parts = rest.split('=');
                        
                        if (parts.length < 2) throw new Error("Syntax error in variable assignment.");
                        
                        let varName = parts[0].trim();
                        let varValueRaw = parts[1].trim();
                        let finalValue = varValueRaw;

                        // معالجة الدوال المدمجة بالمكتبات إذا كانت نشطة
                        if (varValueRaw.includes('(') && varValueRaw.endsWith(')')) {
                            let fnName = varValueRaw.substring(0, varValueRaw.indexOf('(')).trim();
                            let argsRaw = varValueRaw.substring(varValueRaw.indexOf('(') + 1, varValueRaw.length - 1);
                            
                            // دالة الجزر التربيعي من مكتبة الماث الخاصة بفولت
                            if (fnName === 'sqr_val' && activeLibs.has('math')) {
                                let arg = variables[argsRaw] !== undefined ? variables[argsRaw] : parseFloat(argsRaw);
                                finalValue = Math.sqrt(arg);
                            } 
                            // دالة تحويل الحروف لكبيرة من مكتبة النصوص الخاصة بفولت
                            else if (fnName === 'str_upr' && activeLibs.has('str')) {
                                let arg = variables[argsRaw] !== undefined ? variables[argsRaw] : argsRaw.slice(1, -1);
                                finalValue = String(arg).toUpperCase();
                            }
                            // دالة تحويل الحروف لصغيرة من مكتبة النصوص الخاصة بفولت
                            else if (fnName === 'str_lwr' && activeLibs.has('str')) {
                                let arg = variables[argsRaw] !== undefined ? variables[argsRaw] : argsRaw.slice(1, -1);
                                finalValue = String(arg).toLowerCase();
                            }
                        } else {
                            // إذا كانت قيمة عادية (نصية أو رقمية)
                            if ((varValueRaw.startsWith('"') && varValueRaw.endsWith('"')) || (varValueRaw.startsWith("'") && varValueRaw.endsWith("'"))) {
                                finalValue = varValueRaw.slice(1, -1);
                            } else {
                                finalValue = Number(varValueRaw) ? Number(varValueRaw) : varValueRaw;
                            }
                        }

                        variables[varName] = finalValue;
                        continue;
                    }

                } catch (err) {
                    hasError = true;
                    consoleBox.innerHTML += `<div class="console-line error-msg">[Runtime Error Line ${i+1}]: ${err.message}</div>`;
                    break;
                }
            }

            // عرض النتائج النهائية في التيرمينال
            if (!hasError) {
                outputLines.forEach(l => {
                    consoleBox.innerHTML += `<div class="console-line">${l}</div>`;
                });
                consoleBox.innerHTML += `<div class="console-line system-msg" style="color: var(--success)">\n[Process completed successfully]</div>`;
            }
        }
    </script>
</body>
</html>
